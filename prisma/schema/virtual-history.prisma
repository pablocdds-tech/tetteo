  nextPage Int @default(1)
  pageSize Int @default(100)
  pagesProcessed Int @default(0)
  since DateTime
  until DateTime
  startedAt DateTime @default(now())
  finishedAt DateTime?
  lastSyncedAt DateTime?
  importedConversations Int @default(0)
  importedMessages Int @default(0)
  skippedMessages Int @default(0)
  coverageFrom DateTime?
  coverageUntil DateTime?
  complete Boolean @default(false)
  limitReason String?
  error String?
  leaseOwner String?
  leaseUntil DateTime?
  attempts Int @default(0)
  lastPageHash String?
