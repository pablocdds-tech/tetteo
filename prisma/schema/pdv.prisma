// PDV online. Valores monetários em centavos inteiros; snapshots preservam a venda.
model PdvProduto {
  id String @id @default(uuid())
  organizacaoId String
  fichaId String
  codigo String?
  grupos Json @default("[]")
  atualizadoEm DateTime @updatedAt
  @@unique([organizacaoId, fichaId])
  @@unique([organizacaoId, codigo])
  @@map("pdv_produto")
}

model PdvCaixa {
  id String @id @default(uuid())
  organizacaoId String
  unidadeId String
  localEstoqueId String
  abertoPorId String
  operador String
  abertoEm DateTime @default(now())
  fechadoEm DateTime?
  fechadoPorId String?
  saldoInicialCentavos Int
  valorContadoCentavos Int?
  saldoFechamentoCentavos Int?
  observacao String @default("")
  vendas PdvVenda[]
  movimentos PdvMovimentoCaixa[]
  @@unique([organizacaoId, unidadeId, id])
  @@index([organizacaoId, unidadeId, abertoEm])
  @@map("pdv_caixa")
}

model PdvMovimentoCaixa {
  id String @id @default(uuid())
  organizacaoId String
  unidadeId String
  caixaId String
  caixa PdvCaixa @relation(fields: [organizacaoId, unidadeId, caixaId], references: [organizacaoId, unidadeId, id], onDelete: Restrict)
  tipo String
  valorCentavos Int
  motivo String
  usuarioId String
  criadoEm DateTime @default(now())
  @@index([caixaId, criadoEm])
  @@map("pdv_movimento_caixa")
}

model PdvVenda {
  id String @id @default(uuid())
  organizacaoId String
  unidadeId String
  caixaId String
  caixa PdvCaixa @relation(fields: [organizacaoId, unidadeId, caixaId], references: [organizacaoId, unidadeId, id], onDelete: Restrict)
  chave String
  payloadHash String
  usuarioId String
  operador String
  clienteId String?
  cliente String?
  modalidade String
  observacao String @default("")
  status String @default("CONCLUIDA")
  subtotalCentavos Int
  descontoCentavos Int
  taxaCentavos Int
  totalCentavos Int
  trocoCentavos Int
  itens Json
  pagamentos Json
  consumo Json
  criadaEm DateTime @default(now())
  canceladaEm DateTime?
  canceladaPorId String?
  motivoCancelamento String?
  @@unique([organizacaoId, unidadeId, chave])
  @@unique([organizacaoId, unidadeId, id], map: "pdv_venda_escopo_id_key")
  @@index([organizacaoId, unidadeId, criadaEm])
  @@map("pdv_venda")
}

// Carrinho é um rascunho do operador: sem pagamentos, preço congelado ou reserva.
model PdvCarrinho {
  id String @id
  organizacaoId String
  unidadeId String
  usuarioId String
  nome String @default("")
  conteudo Json
  ultimoHash String
  versao Int @default(1)
  status String @default("ATIVO")
  vendaId String? @unique
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  descartadoEm DateTime?
  concluidoEm DateTime?
  @@index([organizacaoId, unidadeId, usuarioId, status, atualizadoEm], map: "pdv_carrinho_operador_estado_data_idx")
  @@map("pdv_carrinho")
}

// Situação operacional, independente da situação financeira da venda.
model PdvPedido {
  id String @id @default(uuid())
  organizacaoId String
  unidadeId String
  vendaId String @unique
  numero Int
  status String @default("COZINHA")
  versao Int @default(1)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  prontoEm DateTime?
  saiuEntregaEm DateTime?
  entregueEm DateTime?
  canceladoEm DateTime?
  eventos PdvPedidoEvento[]
  @@unique([organizacaoId, unidadeId, id])
  @@unique([organizacaoId, unidadeId, numero])
  @@index([organizacaoId, unidadeId, status, criadoEm], map: "pdv_pedido_unidade_status_data_idx")
  @@index([organizacaoId, unidadeId, entregueEm])
  @@index([organizacaoId, unidadeId, canceladoEm])
  @@map("pdv_pedido")
}

model PdvPedidoEvento {
  id String @id @default(uuid())
  organizacaoId String
  unidadeId String
  pedidoId String
  pedido PdvPedido @relation(fields: [organizacaoId, unidadeId, pedidoId], references: [organizacaoId, unidadeId, id], onDelete: Restrict)
  de String?
  para String
  versao Int
  usuarioId String?
  operador String
  observacao String @default("")
  criadoEm DateTime @default(now())
  @@unique([pedidoId, versao])
  @@map("pdv_pedido_evento")
}
