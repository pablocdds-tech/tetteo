// Vendas operacionais e snapshots de itens/status validados pelo contrato.
// Dados pessoais dos pedidos/entregas ficam cifrados em SaiposOperacao.
model SaiposVinculo {
  id String @id @default(cuid())
  organizacaoId String
  unidadeId String @unique
  unidade Unidade @relation(fields: [organizacaoId, unidadeId], references: [organizacaoId, id], onDelete: Restrict)
  lojaSaiposId Int @unique
  habilitado Boolean @default(true)
  cursor String? @db.VarChar(19)
  coberturaDesde String? @db.VarChar(10)
  ultimaTentativaEm DateTime?
  solicitadaEm DateTime?
  ultimoSucessoEm DateTime?
  ultimoErro String?
  ultimaQuantidade Int @default(0)
  concessaoDono String?
  concessaoAte DateTime?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  excluidoEm DateTime?
  canaisAte String? @db.VarChar(10)
  ultimoErroCanais String?
  referencias SaiposReferenciaFechamento[]
  vendas SaiposVenda[]
  detalhesCursor String? @db.VarChar(19)
  detalhesTentativaEm DateTime?
  detalhesSucessoEm DateTime?
  detalhesErro String?
  detalhesDono String?
  detalhesAte DateTime?
  @@unique([organizacaoId, unidadeId])
  @@map("saipos_vinculo")
}

model SaiposVenda {
  crmSales CrmSale[]
  id String @id @default(cuid())
  organizacaoId String
  unidadeId String
  vinculo SaiposVinculo @relation(fields: [organizacaoId, unidadeId], references: [organizacaoId, unidadeId], onDelete: Restrict)
  vendaExternaId String
  dataTurno String @db.VarChar(10)
  totalCentavos Int
  modalidade Int?
  origem String? @db.VarChar(120)
  canalImportado Boolean @default(false)
  cancelada Boolean
  criadaNoSaiposEm DateTime
  alteradaNoSaiposEm DateTime
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  excluidoEm DateTime?
  itensSaipos Json?
  historicoSaipos Json?
  detalhesEm DateTime?
  itensAtualizadosEm DateTime?
  historicoAtualizadoEm DateTime?
  @@unique([organizacaoId, unidadeId, vendaExternaId])
  @@index([organizacaoId, unidadeId, dataTurno, cancelada])
  @@unique([unidadeId, id])
  @@map("saipos_venda")
}


model SaiposReferenciaFechamento {
  id String @id @default(cuid())
  organizacaoId String
  unidadeId String
  vinculo SaiposVinculo @relation(fields: [organizacaoId, unidadeId], references: [organizacaoId, unidadeId], onDelete: Restrict, map: "saipos_referencia_vinculo_fkey")
  de String @db.VarChar(10)
  ate String @db.VarChar(10)
  totalCentavos Int
  versao Int @default(1)
  informadaPorId String
  informadaPor Usuario @relation(fields: [informadaPorId], references: [id], onDelete: Restrict, map: "saipos_referencia_autor_fkey")
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  excluidoEm DateTime?
  @@unique([organizacaoId, unidadeId, de, ate])
  @@map("saipos_referencia_fechamento")
}

// Conteúdos operacionais podem conter endereço e telefone: somente cifrados.
model SaiposOperacao {
  id String @id @default(uuid())
  organizacaoId String
  unidadeId String
  unidade Unidade @relation(fields: [organizacaoId, unidadeId], references: [organizacaoId, id], onDelete: Restrict)
  ambiente String
  tipo String
  chave String @db.VarChar(200)
  referencia String @db.VarChar(100)
  hash String @db.VarChar(64)
  estado String
  payloadCifrado String
  respostaCifrada String?
  erro String?
  versao Int @default(1)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  excluidoEm DateTime?
  @@unique([organizacaoId, unidadeId, ambiente, tipo, chave])
  @@index([organizacaoId, unidadeId, ambiente, tipo, criadoEm])
  @@map("saipos_operacao")
}
