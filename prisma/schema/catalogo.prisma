// ===========================================================================
// CATÁLOGO — dado central
//
// Esta camada NÃO pertence a nenhum App.
//
// `insumo` é escrito pelo Cardápio e lido pelo Estoque, pelas Compras, pelo
// Financeiro e pelo Analytics. É o caso clássico do dado central descrito em
// `src/modules/README.md`: todos leem, só o dono escreve. Mantê-lo dentro de
// `cardapio.prisma` obrigaria o App de Estoque a atravessar exatamente a
// fronteira que o linter existe para impedir.
// ===========================================================================

/// LEGADO — some na M9.
///
/// Substituído pela tabela `unidade_medida` (M2), que precisa existir porque
/// "saco", "caixa" e "fardo" são vocabulário do fornecedor, não do sistema: um
/// enum obrigaria uma migration a cada embalagem nova que a pizzaria comprar.
///
/// Continua populado enquanto a interface antiga o lê. O nome do tipo no
/// Postgres foi renomeado na M1 para liberar `UnidadeMedida` para a tabela.
enum UnidadeMedidaLegado {
  KG
  G
  L
  ML
  UN
}

/// A natureza física do que se mede. Conversão só existe DENTRO da mesma
/// grandeza: kg ↔ g sempre; kg ↔ L nunca. Densidade é propriedade do insumo
/// (1 L de azeite não pesa 1 kg), então "quanto pesa um litro disto" é
/// conversão específica de insumo, não de unidade.
enum GrandezaMedida {
  MASSA
  VOLUME
  CONTAGEM
}

/// A unidade em que se mede, compra e consome.
///
/// Substitui o enum `UnidadeMedidaLegado`. Precisa ser tabela porque "saco",
/// "caixa" e "fardo" são vocabulário do fornecedor, não do sistema — com enum,
/// cada embalagem nova que a pizzaria passasse a comprar exigiria uma migration.
///
/// Semeada POR ORGANIZAÇÃO em vez de global. Oito linhas duplicadas por rede
/// não custam nada e, em troca, toda tabela do sistema fica com exatamente a
/// mesma política de isolamento — sem o caso especial "esta aqui não tem dono"
/// que teria que ser lembrado em cada policy escrita daqui pra frente.
model UnidadeMedida {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])

  codigo String // "kg", "g", "L", "ml", "un", "saco"
  nome   String

  grandeza GrandezaMedida

  /// Quanto vale 1 desta unidade na unidade base da mesma grandeza.
  /// Com base em kg: g → 0,001. Com base em L: ml → 0,001.
  ///
  /// Oito casas porque a conversão é o primeiro elo da cadeia de custo — o
  /// erro que entrar aqui é multiplicado por tudo que vier depois.
  fatorParaBase Decimal @db.Decimal(18, 8)

  /// A unidade de referência da grandeza. Exatamente uma por (organização,
  /// grandeza), garantido por índice parcial criado na M2.
  ehBase Boolean @default(false)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  criadoPorId     String?
  atualizadoPorId String?

  conversoesComoOrigem  ConversaoUnidade[] @relation("ConversaoOrigem")
  conversoesComoDestino ConversaoUnidade[] @relation("ConversaoDestino")
  insumosComoEstoque    Insumo[]           @relation("InsumoUnidadeEstoque")
  insumosComoCompra     Insumo[]           @relation("InsumoUnidadeCompra")

  @@unique([organizacaoId, id])
  @@index([organizacaoId, grandeza])
  // `codigo` único por organização vive num índice parcial (M2), pelo mesmo
  // motivo do nome do insumo: `@@unique` queimaria o código de uma unidade
  // excluída para sempre.
  @@map("unidade_medida")
}

/// A conversão que NÃO é universal.
///
/// kg ↔ g é aritmética e vive em `fatorParaBase`. Já "1 saco = 25 kg" depende
/// do que está dentro do saco: farinha vem em 25 kg, arroz em 5 kg, e nenhuma
/// tabela de unidades resolve isso sem saber de qual insumo se fala.
///
/// VERSIONADA por um motivo concreto: o fornecedor troca a embalagem de 25 kg
/// para 20 kg e as notas antigas precisam continuar sendo lidas com o fator da
/// época. Sem `vigenteDe`, mudar o fator reescreveria o histórico de compras.
model ConversaoUnidade {
  id            String @id @default(cuid())
  organizacaoId String
  insumoId      String
  insumo        Insumo @relation(fields: [organizacaoId, insumoId], references: [organizacaoId, id])

  unidadeOrigemId String
  unidadeOrigem   UnidadeMedida @relation("ConversaoOrigem", fields: [organizacaoId, unidadeOrigemId], references: [organizacaoId, id])

  unidadeDestinoId String
  unidadeDestino   UnidadeMedida @relation("ConversaoDestino", fields: [organizacaoId, unidadeDestinoId], references: [organizacaoId, id])

  /// Quantas unidades de DESTINO cabem em 1 unidade de ORIGEM.
  /// 1 saco de farinha = 25 kg → origem=saco, destino=kg, fator=25.
  fator Decimal @db.Decimal(18, 8)

  vigenteDe  DateTime
  /// `null` = é a vigente hoje. Índice parcial garante uma só por trio.
  vigenteAte DateTime?

  criadoEm    DateTime @default(now())
  criadoPorId String?

  @@index([organizacaoId, insumoId, vigenteDe])
  @@map("conversao_unidade")
}

/// O nível do insumo dentro do estoque.
///
/// O terceiro nível — o produto vendido (Pizza Margherita) — não é insumo e
/// mora em `produto`, na M7. Aqui ficam só os dois que ocupam prateleira.
enum TipoInsumo {
  /// Nível 1: chega de fornecedor. Saco de farinha, bloco de queijo.
  BRUTO

  /// Nível 2: a cozinha produz a partir do nível 1, por Ordem de Produção.
  /// Bolinha de massa, molho temperado. Tem ficha técnica própria, tem
  /// rendimento, tem perda de processo e tem lote com validade.
  MANIPULADO
}

/// Um insumo — o que se compra e se consome: mussarela, farinha, tomate.
///
/// Pertence à ORGANIZAÇÃO, não à unidade. É uma decisão do desenho: o cadastro
/// do insumo é padrão da rede (a mussarela é a mesma receita em todas as
/// lojas), enquanto o SALDO dele é físico e por loja. A regra: o que é padrão é
/// da rede; o que é físico ou aconteceu num lugar é da unidade.
///
/// O que varia legitimamente por loja (trabalha ou não com o item, estoque
/// mínimo próprio) mora em `insumo_por_unidade`, a partir da M3.
model Insumo {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])

  nome      String
  categoria String?
  tipo      TipoInsumo @default(BRUTO)

  unidadeMedida UnidadeMedidaLegado

  /// A unidade em que o SALDO é mantido.
  ///
  /// Toda quantidade do razão é normalizada para cá antes de ser gravada, o
  /// que faz "somar o saldo" ser um SUM puro — sem juntar tabela de conversão
  /// e, principalmente, sem que mudar um fator amanhã reescreva o saldo de
  /// ontem.
  unidadeEstoqueId String
  unidadeEstoque   UnidadeMedida @relation("InsumoUnidadeEstoque", fields: [organizacaoId, unidadeEstoqueId], references: [organizacaoId, id])

  /// A unidade em que normalmente se compra. Só preenche o formulário de
  /// entrada por padrão; nada no cálculo depende dela.
  unidadeCompraId String?
  unidadeCompra   UnidadeMedida? @relation("InsumoUnidadeCompra", fields: [organizacaoId, unidadeCompraId], references: [organizacaoId, id])

  /// O custo de CADASTRO — o que a pessoa digita ao criar o insumo.
  ///
  /// Serve para a ficha técnica mostrar algum número enquanto o insumo não
  /// tem histórico de compra. A partir da M4, o custo que vale é
  /// `saldo_estoque.custoMedio`, calculado e POR LOJA: cada unidade compra
  /// por um preço e guarda um estoque físico diferente.
  custoReferencia Decimal @default(0) @db.Decimal(18, 8)

  /// Etiquetagem ANVISA. O modelo precisa de lote mesmo com a interface
  /// vindo depois: acrescentar rastreio a um razão que já tem movimento
  /// gravado significa não conseguir dizer de qual lote saiu o que já saiu.
  controlaLote Boolean @default(false)
  /// Prazo de validade padrão, contado da produção. Nulo = não perece.
  validadeDias Int?

  /// Dinheiro e quantidade NUNCA em ponto flutuante: 0.1 + 0.2 não dá 0.3 em
  /// binário, e num sistema que soma milhares de lançamentos esse erro vira
  /// divergência real de caixa. Decimal guarda o valor exato.
  ///
  /// LEGADO — some na M9. Hoje é digitado à mão e nada o calcula. A partir da
  /// M4 o custo real passa a ser `saldo_estoque.custoMedio`, que é POR LOJA:
  /// cada unidade compra por um preço e guarda um estoque físico diferente, e
  /// um número só na rede seria mentira em qualquer rede com mais de uma loja.
  custoMedio Decimal @default(0) @db.Decimal(14, 4)

  /// Abaixo disso, o insumo entra na lista de reposição.
  ///
  /// Alargado de (14,3) para (14,4) na M1: quantidade e dinheiro passam a
  /// compartilhar a mesma escala em todo o sistema. Escalas diferentes entre
  /// tabelas que se somam são fonte silenciosa de arredondamento.
  estoqueMinimo Decimal @default(0) @db.Decimal(14, 4)

  ativo Boolean @default(true)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  criadoPorId     String?
  atualizadoPorId String?

  conversoes ConversaoUnidade[]
  porUnidade InsumoPorUnidade[]

  /// Alvo das chaves estrangeiras COMPOSTAS das tabelas que vierem depois.
  ///
  /// É o mecanismo que faz "toda FK valida o mesmo tenant" ser verdade no
  /// banco em vez de promessa: um movimento de estoque da organização A
  /// referencia (organizacaoId, insumoId) e o Postgres recusa, fisicamente,
  /// apontar para um insumo da organização B.
  @@unique([organizacaoId, id])
  @@index([organizacaoId, ativo])
  // O nome único vive num ÍNDICE PARCIAL (`WHERE "excluidoEm" IS NULL`),
  // criado em SQL na M1. Com `@@unique([organizacaoId, nome])` — que valia
  // para todas as linhas — excluir "Mussarela" queimava o nome para sempre:
  // recadastrar batia numa trava apontando para um registro invisível.
  // O Prisma não expressa índice parcial; ver `prisma/schema/README.md`.
  @@map("insumo")
}

/// A exceção por loja.
///
/// `insumo` é da rede — a mussarela é a mesma em todas as lojas. Mas nem toda
/// loja trabalha com todo item, e o ponto de reposição de quem vende 200
/// pizzas por noite não é o de quem vende 40.
///
/// Sem esta tabela, a saída seria duplicar o cadastro por loja, e aí o mesmo
/// insumo passa a ter dois nomes, duas fichas e dois custos que ninguém
/// consegue consolidar depois.
model InsumoPorUnidade {
  id            String  @id @default(cuid())
  organizacaoId String
  unidadeId     String
  unidade       Unidade @relation(fields: [organizacaoId, unidadeId], references: [organizacaoId, id])
  insumoId      String
  insumo        Insumo  @relation(fields: [organizacaoId, insumoId], references: [organizacaoId, id])

  /// Esta loja trabalha com este insumo? Falso não exclui nada — só some das
  /// listas de contagem e de reposição daquela unidade.
  ativo Boolean @default(true)

  /// Sobrepõem `insumo.estoqueMinimo` quando preenchidos. Nulo = usa o da rede.
  estoqueMinimo Decimal? @db.Decimal(14, 4)
  estoqueMaximo Decimal? @db.Decimal(14, 4)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPorId     String?
  atualizadoPorId String?

  /// ÚNICA TABELA DO ESCOPO SEM `excluidoEm`, e de propósito.
  ///
  /// Ela não guarda história — guarda uma configuração que sobrepõe o padrão
  /// da rede. Apagar a linha significa exatamente "volta a valer o padrão",
  /// que é um estado legítimo, e quem mudou o quê já fica registrado em
  /// `auditoria`.
  ///
  /// Com `excluidoEm` aqui, esta trava precisaria virar índice parcial e o
  /// caso comum — a loja voltar a trabalhar com o item — esbarraria numa
  /// linha invisível, que é exatamente o defeito que a M1 corrigiu no insumo.
  @@unique([organizacaoId, unidadeId, insumoId])
  @@index([organizacaoId, unidadeId])
  @@map("insumo_por_unidade")
}
