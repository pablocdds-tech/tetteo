// ===========================================================================
// APP: SEVERINA (assistente)
//
// A Severina não guarda regra de negócio de nenhum App. Ela guarda CONVERSA:
// quem falou, quando, o que foi dito, e o que está para ser dito.
//
// Repare que NENHUMA tabela aqui declara `@relation` para `Organizacao`,
// `Unidade` ou `Usuario`. Os identificadores são texto simples — do mesmo
// jeito que em `estoque.prisma` e `checklists.prisma`. É a regra nº 2 do
// projeto virando banco: se `core.prisma` precisasse ganhar uma contra-relação
// para cada App instalado, o Kernel conheceria os Apps, e instalar módulo
// novo viraria migração do Core.
//
// O preço é aceito conscientemente: sem integridade referencial no banco para
// `usuarioId`, e sem `include`. Quem precisa do nome da pessoa busca em
// `db.usuario` por id. Relação DENTRO do módulo continua relação de verdade.
// ===========================================================================

/// O número de WhatsApp. Uma linha, hoje.
///
/// Existe como tabela por dois motivos concretos, não por simetria: o botão de
/// desligar precisa de um lugar para morar, e a queda de conexão precisa
/// aparecer numa tela em vez de ser descoberta pela reclamação de quem não
/// recebeu o aviso das 7h.
model InstanciaWhatsapp {
  id            String @id @default(cuid())
  organizacaoId String

  /// O nome da instância na Evolution API — "severina-teste"
  nome          String
  numeroProprio String?

  /// A CHAVE GERAL. Desligada, nada sai — nem aviso já confirmado.
  ativa          Boolean   @default(true)
  conectadaEm    DateTime?
  desconectadaEm DateTime?
  ultimoErro     String?

  /// A loja para a qual este número está autorizado. Vazio = a rede inteira.
  ///
  /// Decide quem vê o QR Code: a permissão de conectar vale NA LOJA DA
  /// CONEXÃO, não na loja que a pessoa está olhando. Gerente do Centro não
  /// conecta o número da Zona Sul.
  unidadeId String?

  /// De que jeito o número está ligado. SIMULADO existe para o ensaio e é
  /// recusado em produção pelo conector.
  provedor ProvedorWhatsapp @default(EVOLUTION_BAILEYS)

  /// O que a tela mostra. "Configuração pendente" NÃO mora aqui: é calculada
  /// na leitura a partir das variáveis que faltam — segredo que falta não
  /// vira linha no banco.
  estado        EstadoConexao @default(DESCONECTADO)
  estadoDesde   DateTime?
  /// A última notícia do provedor — consulta respondida ou webhook recebido.
  vistoEm       DateTime?
  motivoAtencao String?

  /// Segura o disparo AUTOMÁTICO dos agentes da Severina. Nasce pausado: nada
  /// sai sozinho até o dono escolher horário, fuso, público e conteúdo. O
  /// aviso confirmado por uma pessoa não passa por aqui.
  agendamentosPausados Boolean @default(true)

  eventosConfiguradosEm DateTime?

  /// O ritmo vale para o NÚMERO, não para cada fila: aviso e agente dividem a
  /// mesma conta pessoal.
  ultimoEnvioEm DateTime?

  /// A última batida do relógio (/api/severina/tick). Sem ela a tela não teria
  /// como dizer "a tarefa agendada não está rodando" — e o sintoma seria um
  /// rascunho que nunca nasce.
  relogioEm DateTime?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  conversas ConversaWhatsapp[]
  eventos   EventoWhatsapp[]
  avisos    AvisoWhatsapp[]

  @@unique([organizacaoId, nome])
  @@map("instancia_whatsapp")
}

enum ProvedorWhatsapp {
  EVOLUTION_BAILEYS
  SIMULADO
}

enum EstadoConexao {
  DESCONECTADO
  CONECTANDO
  CONECTADO
  ATENCAO
}

/// QUEM EXISTE PARA A SEVERINA.
///
/// O WhatsApp migrou para o LID: quem escreve chega como "223170845999336@lid",
/// sem telefone dentro. Comparar com `Usuario.telefone` deixou de funcionar —
/// por isso o vínculo é GRAVADO, não deduzido.
///
/// E ela é, ao mesmo tempo, a lista de quem a Severina enxerga: sem linha
/// aqui, a pessoa não existe, e a mensagem é descartada sem ser gravada. É o
/// que impede os contatos pessoais do número de entrarem no banco de gestão.
model VinculoWhatsapp {
  id            String @id @default(cuid())
  organizacaoId String
  usuarioId     String

  /// O identificador que a Evolution entrega: "…@lid" ou "…@s.whatsapp.net"
  remoteJid String

  /// O telefone em E.164 sem o "+" — "5584981336549"
  telefone String

  confirmadoEm DateTime?

  /// AUTORIZADO PARA AVISOS — e quem autorizou.
  ///
  /// Ter vínculo é existir para a Severina. Receber aviso é outra decisão, de
  /// um responsável: sem esta data, a pessoa não aparece como destinatário.
  /// Separado de `confirmadoEm`, que fica para o LID da fase 2.
  autorizadoEm    DateTime?
  autorizadoPorId String?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@unique([organizacaoId, remoteJid])
  @@index([organizacaoId, telefone])
  @@index([organizacaoId, usuarioId])
  @@map("vinculo_whatsapp")
}

enum TipoAgente {
  AVISO
  COLETA
  MODULO
}

enum GatilhoAgente {
  HORARIO
  ROTINA_VENCIDA

  /// O GATILHO DO AUDITOR — o que separa a Severina de uma mensageira.
  ///
  /// Os outros disparam por relógio: "são 7h, cobre a contagem". Se ninguém
  /// contar a praça por três dias, uma mensageira manda o mesmo bom-dia no
  /// quarto dia, sem notar nada.
  ///
  /// Este dispara por DIFERENÇA entre o que devia ter acontecido e o que
  /// aconteceu: "a praça não é contada há três dias", "o fechamento de ontem
  /// não foi respondido na Centro — na Zona Sul foi", "a pendência da coifa
  /// está aberta há nove dias, com prazo de dois".
  ///
  /// Nenhuma dessas frases cabe num horário. Todas nascem de uma comparação,
  /// e quem sabe fazê-la é o módulo dono do dado — a Severina só pergunta.
  DISCREPANCIA

  MENSAGEM_RECEBIDA
}

/// O que o dono cria na tela — a peça que faz a Severina não depender de
/// programador para mudar horário, destinatário ou jeito de falar.
///
/// A divisão entre `instrucoes` e `limites` é a regra que sustenta a
/// segurança disso: instrução é texto livre e INFLUENCIA o modelo; limite é
/// campo estruturado e é conferido pelo código ANTES de agir.
///
/// "Nunca feche contagem acima de R$ 5.000" escrito na caixa de instruções é
/// um pedido — o modelo quase sempre obedece. Quase. O mesmo limite como campo
/// é uma parede: o modelo não convence um `if`.
///
/// Nada que não se pode perder mora na caixa de texto.
model AgenteSeverina {
  id            String @id @default(cuid())
  organizacaoId String

  /// Vazio = vale para a rede inteira
  unidadeId String?

  nome  String
  tipo  TipoAgente @default(AVISO)
  ativo Boolean    @default(true)

  gatilho GatilhoAgente

  /// HORARIO        → { "horario": "07:00", "diasDaSemana": [1,2,3,4,5] }
  /// ROTINA_VENCIDA → { "modulo": "estoque" }
  gatilhoConfig Json @default("{}")

  destinatariosPapeis   String[] @default([])
  destinatariosUsuarios String[] @default([])

  /// MOLE — orienta o Gemini na redação
  instrucoes String

  /// Fases seguintes. Declarados agora para não migrar de novo depois.
  perguntas            Json     @default("[]")
  ferramentasLiberadas String[] @default([])

  /// DURO — { "janelaInicio": "06:00", "janelaFim": "22:00",
  ///          "maxAcoesPorConversa": 8, "aceitaAudio": true }
  limites Json @default("{}")

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  conversas ConversaWhatsapp[]

  @@index([organizacaoId, ativo])
  @@map("agente_severina")
}

enum EstadoConversa {
  ABERTA
  AGUARDANDO_CONFIRMACAO
  ENCERRADA
}

/// O assunto em aberto com uma pessoa.
///
/// `unidadeId` é o que resolve o problema do número único da rede: a resposta
/// "12 kg" sabe de qual estoque é porque a CONVERSA sabe — não porque o
/// telefone sabe. Quem trabalha em duas lojas não precisa ser perguntado.
model ConversaWhatsapp {
  id          String            @id @default(cuid())
  instanciaId String
  instancia   InstanciaWhatsapp @relation(fields: [instanciaId], references: [id])
  agenteId    String
  agente      AgenteSeverina    @relation(fields: [agenteId], references: [id])

  organizacaoId String
  unidadeId     String?
  remoteJid     String
  usuarioId     String

  referenciaTipo String?
  referenciaId   String?

  estado EstadoConversa @default(ABERTA)

  /// Congela ferramenta, argumentos e prazo enquanto espera a palavra de
  /// confirmação. Fase 3 — declarado agora para não migrar de novo.
  acaoPendente Json?

  ultimaMensagemEm DateTime @default(now())

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens MensagemWhatsapp[]

  @@index([organizacaoId, ultimaMensagemEm])
  @@index([agenteId, estado])
  @@index([usuarioId])
  @@map("conversa_whatsapp")
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

enum TipoMensagem {
  TEXTO
  IMAGEM
  DOCUMENTO
  AUDIO
}

enum StatusMensagem {
  PENDENTE
  ENVIADA
  ENTREGUE
  FALHOU
}

/// Tudo que entra e tudo que sai, numa tabela só.
///
/// É ela que vira a linha do tempo da aba Conversas, e a fila de saída é só
/// `direcao=SAIDA AND status=PENDENTE`. Duas tabelas dariam duas metades de
/// uma história que se lê junto.
///
/// `idExterno` ÚNICO é a trava contra webhook repetido: a Evolution reenvia
/// quando não tem certeza de que chegou, e sem isso "entrou 12kg" viraria
/// 24kg. É a mesma lógica da `entrega_evento` do Core, escrita pelo mesmo
/// motivo.
model MensagemWhatsapp {
  id         String           @id @default(cuid())
  conversaId String
  conversa   ConversaWhatsapp @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  direcao DirecaoMensagem
  tipo    TipoMensagem    @default(TEXTO)

  /// O id da mensagem na Evolution. Nulo enquanto a nossa não foi enviada.
  idExterno String? @unique

  texto    String?
  midiaUrl String?

  status     StatusMensagem @default(PENDENTE)
  tentativas Int            @default(0)
  erro       String?

  /// POR QUE a Severina falou — "agente:clx91…" ou "agente:clx91…:rotina:clx8…".
  /// Responde a pergunta do primeiro dia em que algo sair errado.
  origem String?

  agendadaPara DateTime?
  enviadaEm    DateTime?
  recebidaEm   DateTime?

  criadoEm DateTime @default(now())

  @@index([status, direcao, agendadaPara])
  @@index([conversaId, criadoEm])
  @@index([origem])
  @@map("mensagem_whatsapp")
}

// ---------------------------------------------------------------------------
// EVENTOS E AVISOS — a entrada do provedor e a saída que um humano confirma
// ---------------------------------------------------------------------------

enum StatusEventoWhatsapp {
  RECEBIDO
  PROCESSADO
  IGNORADO
  FALHOU
}

/// TUDO QUE A EVOLUTION CONTOU — limpo.
///
/// `resumo` guarda só campos permitidos: estado, id de mensagem, status, o
/// hash do texto. Nunca o texto, o `remoteJid`, o nome de perfil ou o QR
/// Code. O número é uma conta pessoal, e o painel de saúde não é lugar de
/// conversa de ninguém.
///
/// A chave única é a trava contra webhook repetido: a Evolution reenvia até
/// dez vezes quando não tem certeza de que chegou. O repetido só soma em
/// `repeticoes` — o trabalho não se refaz.
model EventoWhatsapp {
  id            String            @id @default(cuid())
  organizacaoId String
  instanciaId   String
  instancia     InstanciaWhatsapp @relation(fields: [instanciaId], references: [id])

  /// O providerEventId. Por tipo: "status:<id>:<status>", "envio:<id>",
  /// "entrada:<id>", "conexao:<sha256 do corpo>".
  idExterno String
  tipo      String

  status StatusEventoWhatsapp @default(RECEBIDO)
  motivo String?
  resumo Json                 @default("{}")

  repeticoes Int @default(0)
  tentativas Int @default(0)

  recebidoEm        DateTime  @default(now())
  processadoEm      DateTime?
  ultimaRepeticaoEm DateTime?

  @@unique([instanciaId, idExterno])
  @@index([organizacaoId, recebidoEm])
  @@index([status, recebidoEm])
  @@map("evento_whatsapp")
}

/// O caminho de um aviso. Cada etapa só ganha horário com PROVA:
///
///   RASCUNHO    nasceu (de um evento do sistema, ou de alguém)
///   CONFIRMADO  um responsável escolheu o destinatário e confirmou
///   NA_FILA     a entrega pegou o aviso e está falando com o provedor
///   ACEITO      a Evolution respondeu 201 com o id — NÃO quer dizer entregue
///   ENTREGUE    chegou o DELIVERY_ACK
///   LIDO        chegou o READ
///
///   INCERTO     o resultado é desconhecido (tempo esgotado, 5xx). Não se
///               reenvia sozinho: consulta-se o provedor, e se não achar, um
///               humano decide
///   FALHOU      recusado de vez, ou desistência depois das tentativas
///   DESCARTADO  alguém decidiu que não sai
enum StatusAvisoWhatsapp {
  RASCUNHO
  CONFIRMADO
  NA_FILA
  ACEITO
  ENTREGUE
  LIDO
  INCERTO
  FALHOU
  DESCARTADO
}

/// UM AVISO INTERNO — o OutgoingMessage.
///
/// `idPedido` é a chave de idempotência do pedido: o mesmo fechamento nunca
/// vira dois rascunhos, por mais que o relógio pergunte. `referencia` vai no
/// fim do texto e torna cada mensagem única — é o que permite achar no
/// provedor, depois de um tempo esgotado, se ela saiu ou não.
///
/// O destinatário é uma REFERÊNCIA ao vínculo, nunca um telefone solto: o
/// número é resolvido na hora de enviar, e só se a pessoa continuar
/// autorizada.
model AvisoWhatsapp {
  id            String            @id @default(cuid())
  organizacaoId String
  unidadeId     String?
  instanciaId   String
  instancia     InstanciaWhatsapp @relation(fields: [instanciaId], references: [id])

  idPedido   String
  referencia String

  /// De onde veio: "checklists.fechamento" ou "manual".
  origemTipo String
  origemId   String?

  /// O que o destinatário precisa poder ver para receber este aviso. Cada um
  /// só ouve o que teria direito de ver na tela.
  permissaoNecessaria String?

  titulo String
  corpo  String
  link   String?

  /// VinculoWhatsapp.id
  destinatarioRef String?

  status             StatusAvisoWhatsapp @default(RASCUNHO)
  idMensagemProvedor String?

  tentativas          Int       @default(0)
  proximaTentativaEm  DateTime?
  tentativaIniciadaEm DateTime?
  verificacoes        Int       @default(0)
  verificadoEm        DateTime?
  erro                String?

  /// requestedBy. Vazio = nasceu de um evento do sistema.
  solicitadoPorId String?
  /// confirmedBy.
  confirmadoPorId String?
  descartadoPorId String?

  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt
  confirmadoEm  DateTime?
  enfileiradoEm DateTime?
  aceitoEm      DateTime?
  entregueEm    DateTime?
  lidoEm        DateTime?
  falhouEm      DateTime?
  descartadoEm  DateTime?

  @@unique([organizacaoId, idPedido])
  @@unique([instanciaId, idMensagemProvedor])
  @@unique([referencia])
  @@index([organizacaoId, status, criadoEm])
  @@index([status, proximaTentativaEm])
  @@map("aviso_whatsapp")
}
