# =============================================================================
# TETTEO — modelo de configuração
#
# Este arquivo é versionado e serve de referência: mostra QUAIS variáveis
# existem, nunca os valores reais.
#
# Para rodar localmente: copie para `.env.local` e preencha.
# O `.env.local` é ignorado pelo Git e nunca sai da sua máquina.
#
# Em produção, os valores são configurados no painel do Dokploy — não em
# arquivo. Segredo em arquivo acaba em backup, em log e em print de tela.
# =============================================================================

# Onde o sistema está publicado. Em desenvolvimento é o endereço local.
APP_URL="http://localhost:3000"

# Banco de dados PostgreSQL.
# Formato: postgresql://usuario:senha@servidor:porta/banco
DATABASE_URL=""

# Segredo que assina o token de sessão. Gere um valor aleatório único por
# ambiente: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Necessário quando o app roda atrás de um proxy (Traefik, na VPS).
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# COMPRAS — envio ao fornecedor (detalhes em docs/compras/README.md)
# -----------------------------------------------------------------------------

# Canal das mensagens aos fornecedores: "simulador" (padrão: nada sai) ou
# "whatsapp" (Evolution API). Em teste é sempre o simulador.
COMPRAS_CANAL="simulador"

# Instância da Evolution SÓ de Compras — nunca a mesma da Severina — e o
# token dessa instância. A URL da Evolution (EVOLUTION_URL) é a mesma.
COMPRAS_EVOLUTION_INSTANCIA=""
COMPRAS_EVOLUTION_API_KEY=""

# Senha do relógio que chama POST /api/compras/tick a cada minuto (cabeçalho
# x-compras-segredo). Sem ela, a rota fica fechada.
COMPRAS_TICK_SEGREDO=""

# Pasta das fotos do recebimento. Em produção, um volume persistente (padrão
# /app/arquivos); em desenvolvimento, .arquivos/ na raiz.
ARQUIVOS_DIR=""
