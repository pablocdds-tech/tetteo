# =============================================================================
# TETTEO — modelo de configuração
#
# Este arquivo é versionado e serve de referência: mostra QUAIS variáveis
# existem, nunca os valores reais.
#
# Para rodar localmente: copie para `.env.local` e preencha.
# O `.env.local` é ignorado pelo Git e nunca sai da sua máquina.
#
# Em produção, os valores são configurados no painel do Dokploy — não em
# arquivo. Segredo em arquivo acaba em backup, em log e em print de tela.
# =============================================================================

# Onde o sistema está publicado. Em desenvolvimento é o endereço local.
APP_URL="http://localhost:3000"

# Banco de dados PostgreSQL.
# Formato: postgresql://usuario:senha@servidor:porta/banco
DATABASE_URL=""

# Segredo que assina o token de sessão. Gere um valor aleatório único por
# ambiente: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Necessário quando o app roda atrás de um proxy (Traefik, na VPS).
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# WHATSAPP (Evolution API 2.3.7, modalidade Baileys)
#
# Todos vazios de propósito. Os valores reais ficam só no ambiente privado do
# servidor (Dokploy). Sem eles, a tela WhatsApp mostra "Configuração pendente"
# com o NOME do que falta — e nada é enviado.
# -----------------------------------------------------------------------------

# A Evolution, por DENTRO da rede do Docker. Não é segredo.
EVOLUTION_URL="http://evolution_api:8080"

# O nome da instância que JÁ EXISTE na Evolution. O Tetteo não cria instância.
EVOLUTION_INSTANCIA=""

# A chave DA INSTÂNCIA (o "token" dela), nunca a chave global da Evolution.
# Na 2.3.7 ela vale em toda rota com o nome da instância no caminho.
EVOLUTION_API_KEY=""

# O endereço que a Evolution chama, pela rede interna do Docker:
# http://<nome-do-contêiner-do-tetteo>:3000/api/whatsapp/webhook
WHATSAPP_WEBHOOK_URL=""

# A senha do passe do webhook (mínimo 16 caracteres). Gere NO SERVIDOR:
#   openssl rand -hex 32
# A Evolution assina cada chamada com ela; o Tetteo confere.
WHATSAPP_WEBHOOK_CHAVE=""

# Só durante a troca da senha: a anterior continua aceita até a nova ser
# aplicada na Evolution (tela WhatsApp → Aplicar configuração). Depois, apague.
WHATSAPP_WEBHOOK_CHAVE_ANTERIOR=""

# O relógio (/api/severina/tick) exige este cabeçalho. É ele que consulta a
# saúde do número, cria os rascunhos e entrega os avisos confirmados.
#   openssl rand -hex 32
SEVERINA_TICK_SEGREDO=""
